# Temporada e agenda
ACTIVE_SEASON=season-1-carros.json
CRON_SCHEDULE=0 12 * * *
TIMEZONE=America/Sao_Paulo

# Fase 1: mantenha false. Com false, o vídeo fica disponível para publicação manual.
PUBLISH_ENABLED=false

# Alertas (obrigatório em produção para receber notificações)
DISCORD_WEBHOOK_URL=

# Renderização
VIDEO_DURATION_SECONDS=10
WHEEL_SPIN_SOUND_PATH=/app/assets/audio/wheel-spin.mp3
REMOTION_CONCURRENCY=50%
FFMPEG_PATH=ffmpeg
LOG_LEVEL=info

# Legenda com IA. Apenas a chave do provider selecionado é necessária.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_WEB_SEARCH_ENABLED=false
AI_TIMEOUT_MS=15000

# Caminhos (os defaults abaixo são usados dentro do container)
DATA_DIR=/app/data/seasons
OUTPUT_DIR=/app/output
AUDIO_DIR=/app/assets/audio

# Fase 2 — Instagram Graph API
# IG_ACCESS_TOKEN=
# IG_BUSINESS_ACCOUNT_ID=

# Fase 2 — TikTok Content Posting API
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
